# Copy to .env for local development. Never commit real values.

SERVICE_NAME=everycred-integration-service
# One of: local, development, staging, production
ENVIRONMENT=local

LOG_LEVEL=INFO
# Use true in deployed environments.
LOG_JSON=false

# API docs are always disabled in production regardless of this flag.
ENABLE_DOCS=true
# JSON list, for example ["https://app.example.com"]
CORS_ALLOWED_ORIGINS=[]

# MySQL / MariaDB through the aiomysql driver. In Docker, use
# host.docker.internal for a MySQL server running on the host.
DATABASE_URL=mysql+aiomysql://<user>:<password>@127.0.0.1:3306/<database>?charset=utf8mb4
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
DATABASE_POOL_RECYCLE_SECONDS=1800

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_CONNECTIONS=100

# At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Only needed to register the first super admin; remove afterwards.
SUPER_ADMIN_BOOTSTRAP_TOKEN=<random-token>
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# At least 32 characters. Keys the stored HMAC of client API keys;
# changing it invalidates every issued key.
API_KEY_HASH_SECRET=<random-secret>

# Comma-separated Fernet keys; the first encrypts, all decrypt. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEYS=<fernet-key>
CONNECTOR_TIMEOUT_SECONDS=30

# Where credentials and user inputs are stored: "local" (development
# only, encrypted in the local database) or "aws" (Secrets Manager
# encrypted with a KMS key; required in production).
SECRET_STORE_BACKEND=local
# Required when SECRET_STORE_BACKEND=aws. AWS credentials come from the
# standard chain (IAM role, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
AWS_REGION=
SECRETS_KMS_KEY_ID=
SECRETS_NAME_PREFIX=everycred/integration-service
SECRET_RECOVERY_WINDOW_DAYS=7
